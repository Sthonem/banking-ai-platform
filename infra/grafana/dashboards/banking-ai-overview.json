{
  "title": "Banking AI Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Requests",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (handler, method, status) (rate(http_requests_total[1m]))", "legendFormat": "{{method}} {{handler}} {{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Latency p95",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{handler}}" }
      ]
    }
  ]
}
